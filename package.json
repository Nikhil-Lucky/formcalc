{
  "name": "formcalc",
  "version": "2.0.0",
  "private": true,
  "description": "A tactile calculator workspace with scientific math, history and unit conversion.",
  "type": "module",
  "repository": { "type": "git", "url": "https://github.com/Nikhil-Lucky/formcalc.git" },
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "node scripts/test.mjs",
    "test:browser": "node tests/browser.mjs",
    "check": "npm run build && npm test && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "engines": { "node": ">=22" }
}
